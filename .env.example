# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# Opcional: troca o modelo usado para ler e classificar
CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp (Meta Cloud API) ---
# Token de acesso do app na Meta (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
# ID do número de telefone (aparece na mesma tela)
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha que você inventa e cola também na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Configurações do app > Básico). Usada para conferir que a mensagem veio mesmo da Meta.
WHATSAPP_APP_SECRET=

# --- Telegram (opcional) ---
# Token que o @BotFather entrega ao criar o bot
TELEGRAM_BOT_TOKEN=
# Uma senha que você inventa (letras, números, _ e -). Usada para ligar o bot e conferir que a mensagem veio do Telegram.
TELEGRAM_WEBHOOK_SECRET=

# --- Google Sheets ---
# JSON da conta de serviço do Google, numa linha só. Compartilhe cada planilha com o e-mail dessa conta como Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Usuários do piloto ---
# Lista em JSON. telefone no formato internacional, só números (ex.: 5511999998888).
# telegram (opcional): o código que o bot mostra para quem ainda não está cadastrado.
# cartoes: fechamento e vencimento são os dias do mês.
DINOMONEY_USUARIOS=[{"nome":"Maria","telefone":"5511999998888","planilhaId":"COLE_AQUI_O_ID_DA_PLANILHA","abaFluxo":"Cashflow","contas":["Itaú","Inter","Infinite Pay","Wise"],"cartoes":[{"nome":"Nubank","fechamento":3,"vencimento":10}]}]
